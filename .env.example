# Local guest mode needs no database, OAuth or AI credentials.
NODE_ENV=development
PORT=3000

# Accounts: PostgreSQL. Use Neon's TLS connection string in production.
# Example local: postgresql://localhost:5432/datapath
# Neon: use sslmode=verify-full; never disable certificate verification.
DATABASE_URL=
# Optional direct/unpooled URL for migration commands (falls back to DATABASE_URL).
DATABASE_MIGRATION_URL=
# Required for accounts and production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Existing Manus-compatible OAuth integration (not a generic Google OAuth endpoint).
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional server-side AI service. Never place this key in a VITE_ variable.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Production origin: HTTPS, no trailing slash. Required for production startup.
APP_ORIGIN=
# Set 1 only when exactly one trusted reverse proxy sits in front of this app.
TRUST_PROXY=0
