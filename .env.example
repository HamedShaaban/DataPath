# Local guest mode needs no database, OAuth or AI credentials.
NODE_ENV=development
PORT=3000

# Accounts: PostgreSQL. Use Neon's TLS connection string in production.
# Example local: postgresql://localhost:5432/datapath
# Neon: use sslmode=verify-full; never disable certificate verification.
DATABASE_URL=
# Optional direct/unpooled URL for migration commands (falls back to DATABASE_URL).
DATABASE_MIGRATION_URL=

# Existing Manus-compatible OAuth integration (not a generic Google OAuth endpoint).
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional server-side AI service. Never place this key in a VITE_ variable.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Production origin: HTTPS, no trailing slash. Required for production startup.
APP_ORIGIN=
# Set 1 only when exactly one trusted reverse proxy sits in front of this app.
TRUST_PROXY=0

# Required when enabling AI. Pin an exact model ID supported by your provider.
AI_MODEL=
# Enter verified provider prices; no guessed pricing defaults are used.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Application-wide monthly USD cap (UTC calendar month).
AI_MONTHLY_CAP_USD=
AI_REQUESTS_PER_HOUR=20
AI_TIMEOUT_MS=25000

# Optional error reporting: server DSN at runtime, public client DSN at build time.
# Leave empty to disable. No prompts, CVs, cookies or error text are sent.
SENTRY_DSN=
VITE_SENTRY_DSN=
